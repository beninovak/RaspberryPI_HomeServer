<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
     
    <Style Selector="Grid.todo-grid">
        <Setter Property="Margin" Value="0, 2,0, 2"></Setter>
    </Style>
    
    <!-- Action buttons -->
    <Style Selector="Button.todo-action">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0:0.1"/>
            </Transitions>
        </Setter>
        
        <Setter Property="Width" Value="32"></Setter>
        <Setter Property="Height" Value="32"></Setter>
        <Setter Property="Padding" Value="0"></Setter>
        <Setter Property="Margin" Value="0, 0, 8, 0"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    
    <Style Selector="Button.todo-action:pointerover:pressed">
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    
    <!-- Cringe -->
    <Style Selector="Button.todo-action ContentPresenter">
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    <!-- Cringe end -->
    
    <Style Selector="Button.todo-edit">
        <Setter Property="Opacity" Value="1"></Setter>
    </Style>
    
    <Style Selector="Button.todo-save">
        <Setter Property="Opacity" Value="0"></Setter>
    </Style>
    
    <Style Selector="Button.todo-action:disabled">
        <Setter Property="Opacity" Value="0"></Setter>
    </Style>
    
    <Style Selector="Button.todo-action:not(:disabled)">
        <Setter Property="Opacity" Value="1"></Setter>
    </Style>
    <!-- Action buttons end -->

    <Style Selector="TextBox.todo-text">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Easing="CubicEaseInOut" Property="Background" Duration="0:0:0:0.25"/>
                <ThicknessTransition Easing="CubicEaseInOut" Property="Padding" Duration="0:0:0:0.25"/>
            </Transitions>
        </Setter>
        <Setter Property="FontSize" Value="24"></Setter>
        <Setter Property="LineHeight" Value="32"></Setter>
        <Setter Property="Height" Value="40"></Setter>
        <Setter Property="Padding" Value="0, 4, 0, 4"></Setter>
        <Setter Property="Margin" Value="0, 0, 24, 0"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="CaretBrush" Value="Transparent"></Setter>
    </Style>
    
    <Style Selector="TextBox.todo-text /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Easing="CubicEaseInOut" Property="Background" Duration="0:0:0:0.25"/>
            </Transitions>
        </Setter>
        
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    
    <Style Selector="TextBox.todo-text.editing">
        <Setter Property="CaretBrush" Value="#ffffff"></Setter>
        <Setter Property="Background" Value="#40ffffff"></Setter>
        <Setter Property="Padding" Value="24, 4, 0, 4"></Setter>

        <Style Selector="^ /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Background" Value="#40ffffff"></Setter>
        </Style>
    </Style>
    
    <Style Selector="CheckBox.todo-checkbox">
        <Setter Property="Height" Value="24"></Setter>
        <Setter Property="MinHeight" Value="24"></Setter>
        
        <Style Selector="^ Grid">
            <Setter Property="Height" Value="24"></Setter>
        </Style>
    </Style>
</Styles>
