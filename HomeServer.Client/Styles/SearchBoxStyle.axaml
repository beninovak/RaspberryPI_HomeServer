<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="UserControl.search-box">
        <Setter Property="Background" Value="#ffffff"></Setter>
    </Style>
    
    <Style Selector="TextBox.search-input">
        <Setter Property="Height" Value="64"></Setter>
        <Setter Property="LineHeight" Value="50"></Setter>
        <Setter Property="Padding" Value="12, 6, 12, 6"></Setter>
        <Setter Property="FontSize" Value="32"></Setter>
        <Setter Property="Background" Value="orange"></Setter>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
    </Style>
    
    <Style Selector="TextBox.search-input:pointerover">
        <Setter Property="Background" Value="yellow"></Setter>
    </Style>
    
    <Style Selector="TextBox.search-input:focus">
        <Setter Property="Background" Value="lime"></Setter>
    </Style>
    
    <!-- ######## Clear button ####### -->
    <Style Selector="Button.search-button">
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Width" Value="64"></Setter>
        <Setter Property="Height" Value="64"></Setter>
        <Setter Property="Padding" Value="0"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
    </Style>
    
    <Style Selector="Button.search-button Path">
        <Setter Property="Width" Value="40"></Setter>
        <Setter Property="Height" Value="40"></Setter>
        <Setter Property="Fill" Value="Purple"></Setter>
        <Setter Property="Stretch" Value="UniformToFill"></Setter>
    </Style>
</Styles>
