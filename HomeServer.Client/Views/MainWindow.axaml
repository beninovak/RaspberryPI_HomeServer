<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HomeServer.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowState="Maximized"
        x:Class="HomeServer.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon=""
        Title="Banger program"
        
        Closing="Window_OnClosing"
        
        Width="{OnFormFactor Desktop=2160, Mobile=1080}"
        Height="{OnFormFactor Desktop=1440, Mobile=2340}"
        d:DesignWidth="1600" d:DesignHeight="900">
        <!-- TODO - Add Icon to Window -->
        <!-- Window Width and Height are hardcoded for my phone and desktop monitors🥰 🥰🥰🥰-->
        
        <Window.Styles>
            <StyleInclude Source="../Styles/MainWindowStyle.axaml"></StyleInclude>
        </Window.Styles>
        
        <DockPanel>
            <StackPanel x:Name="PageButtons">
                <Button x:Name="HomeTab" Content="Home"
                        Command="{Binding OpenPageCommand}"
                        CommandParameter="HOME">
                </Button>
                <Button x:Name="TodoTab" Content="TODOs"
                        Command="{Binding OpenPageCommand}"
                        CommandParameter="TODO">
                </Button>
                <Button x:Name="ExpensesTab" Content="Expenses"
                        Command="{Binding OpenPageCommand}"
                        CommandParameter="EXPENSE"></Button>
                
                <Button x:Name="FilesTab" Content="Files"
                        Command="{Binding OpenPageCommand}"
                        CommandParameter="FILE"></Button>
            </StackPanel>

            <TransitioningContentControl 
                x:Name="ContentView" 
                Content="{Binding CurrentView}">
            </TransitioningContentControl>
        </DockPanel>
</Window>