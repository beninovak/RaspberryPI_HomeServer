<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:HomeServer.Client.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HomeServer.Client.Controls.SearchBox"
             Classes="search-box">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/SearchBoxStyle.axaml"></StyleInclude>
    </UserControl.Styles>
    
    <Grid ColumnDefinitions="20*, 60*, 20*">
        <Grid Grid.Column="1" ColumnDefinitions="*">
            <TextBox 
                x:Name="InputBox"
                Classes="search-input"
                x:DataType="controls:SearchBox"
                KeyUp="InputBox_OnKeyUp"
                Watermark="{Binding Placeholder}">
            </TextBox>
        
            <Button
                x:Name="SearchButton"
                Classes="search-button"
                Click="SearchButton_OnClick" IsDefault="True">
                <Path 
                    Data="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 
                    579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3
                     465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 
                     64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 
                     192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z"
                />
            </Button>
        </Grid>
    </Grid>
</UserControl>
