<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:HomeServer.Core.Models;assembly=HomeServer.Core"
             xmlns:controls="clr-namespace:HomeServer.Client.Controls"
             xmlns:todos="clr-namespace:HomeServer.Core.Models.Todos;assembly=HomeServer.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HomeServer.Client.Controls.TodoItem"
             x:DataType="controls:TodoItem"
             x:Name="todoItem"
             PointerReleased="TodoCheckUncheck">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/Controls/TodoItemStyle.axaml"></StyleInclude>
    </UserControl.Styles>
    
    <Grid
        Classes="todo-grid"
        ColumnDefinitions="40, *, 20"
        Background="Transparent">
        <Button
            IsEnabled="{Binding  !IsEditing, ElementName=todoItem}"
            Grid.Column="0"
            Classes="todo-action todo-edit"
            Click="Todo_OnEditClick">
            <Image Source="../Assets/edit.png"></Image>    
        </Button>

        <Button
            Grid.Column="0"
            IsEnabled="{Binding  IsEditing, ElementName=todoItem}"
            Classes="todo-action todo-save"
            Click="Todo_OnSaveClick">
            <Image Source="../Assets/checkmark.png"></Image>
        </Button>
        
        <TextBox
            x:DataType="todos:Todo"
            x:Name="textBox"
            Grid.Column="1"
            Classes="todo-text"
            Classes.editing="{Binding IsEditing, ElementName=todoItem}"
            IsReadOnly="{Binding !IsEditing, ElementName=todoItem}"
            Text="{Binding Content}"/>
        <CheckBox
            x:DataType="todos:Todo"
            Grid.Column="2"
            Classes="todo-checkbox"
            IsHitTestVisible="False"
            IsChecked="{Binding IsDone}"/>
    </Grid>
    
</UserControl>
