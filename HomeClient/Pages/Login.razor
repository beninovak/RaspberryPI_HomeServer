@page "/login"
@using HomeClient.ResponseDTOs
@using HomeClient.Services
@inject UserService UserService;

<PageTitle>Login</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/user_forms.css"/>
</HeadContent>

<form method="post" action="/api/Login">
    <h1>Login</h1>

    <div class="group wrapper">
        <div class="fields">
            <div class="group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Email" @bind="email">
                <p class="error">@emailError</p>
            </div>

            <div class="group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Password" @bind="password">
                <p class="error">@passwordError</p>    
            </div>  
        </div>
        
        <p class="error">@generalError</p>
    </div>
    
    <div class="group button">
        <button type="button" @onclick="DoLogin">Login</button>
            
        <div class="links">
            <a href="/register">Register</a>
            <a href="/forgotten-password">Forgot password?</a>
        </div>
    </div>
</form>

@code {
    private string email = string.Empty;
    private string password = string.Empty;

    private string? emailError, passwordError, generalError;
    
    private async Task DoLogin() {
        BadLoginResponse? response = await UserService.Login(email, password);

        if (response is not null) {
            emailError = String.Join('\n', response.Email ?? []);
            passwordError = String.Join('\n', response.Password ?? []);
            generalError = String.Join('\n', response.General ?? []);
            StateHasChanged();
        }
    }
}