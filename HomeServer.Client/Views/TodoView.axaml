<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HomeServer.Client.ViewModels"
             x:DataType="vm:TodoViewModel"
             xmlns:controls="using:HomeServer.Client.Controls"
             mc:Ignorable="d"
             x:Class="HomeServer.Client.Views.TodoView"
             Classes="view"
             d:DesignWidth="800" d:DesignHeight="450"
             Loaded="TodoView_OnLoaded">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/TodoStyles.axaml"></StyleInclude>
    </UserControl.Styles>
    
    <Border Classes="wrapper">
        <Grid Classes="main-grid">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <TextBlock
                Grid.Row="0"
                Classes="view-title"
                Text="TODOs">
            </TextBlock>
            
            <controls:SearchBox
                Grid.Row="1" 
                x:Name="TodoSearchBox"
                x:DataType="vm:TodoViewModel"
                Placeholder="Search TODOs and sections"
                Search="TodoSearchBox_OnSearch">
            </controls:SearchBox>
            
            <ScrollViewer Grid.Row="2">
                <ItemsControl 
                    ItemsSource="{Binding TodosBySections}">
                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{OnFormFactor Desktop=3, Mobile=1}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander 
                                Classes="todo-section"
                                Header="{Binding Title}">
                                <ItemsControl 
                                    ItemsSource="{Binding Todos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Content}"/>
                                                <CheckBox IsChecked="{Binding IsDone}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>